{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "productName": "PetCompanion",
  "version": "1.0.0",
  "identifier": "com.petcompanion.app",
  "app": {
    "windows": [
      {
        "title": "小组学习陪伴宠物",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "label": "main"
      },
      {
        "label": "pet",
        "title": "桌面宠物",
        "width": 200,
        "height": 220,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "alwaysOnTop": true,
        "transparent": true,
        "skipTaskbar": true,
        "visible": false,
        "url": "/pet.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self';"
    }
  },
  "plugins": {}
}
